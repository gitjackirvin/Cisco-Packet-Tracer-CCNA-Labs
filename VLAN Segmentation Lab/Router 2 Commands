// Router to Router Link Setup
Router>
Router>en
Router#conf t
Router(config)#int g0/2
Router(config-if)#ip address 10.10.10.2 255.255.255.0
Router(config-if)#no shutdown
Router(config-if)#exit

// VLAN 30 Subinterface
Router>
Router>en
Router#conf t
Router(config)#int g0/1.30
Router(config-subif)#encapsulation dot1Q 30
Router(config-subif)#ip address 172.168.10.254 255.255.255.0
Router(config-subif)#no shutdown
Router(config-subif)#exit

// VLAN 40 Subinterface
Router>
Router>en
Router#conf t
Router(config)#int g0/1.40
Router(config-subif)#encapsulation dot1Q 40
Router(config-subif)#ip address 172.168.20.254 255.255.255.0
Router(config-subif)#no shutdown
Router(config-subif)#exit
